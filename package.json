{
  "name": "life-planner",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "scripts": {
    "dev": "scripts/with-node.sh convex dev --start 'vite dev'",
    "dev:netlify": "scripts/with-node.sh netlify dev",
    "deploy:preview": "scripts/with-node.sh netlify deploy --build",
    "build": "scripts/with-node.sh bash -c 'vite build && tsc --noEmit'",
    "start": "scripts/with-node.sh node .output/server/index.mjs",
    "format": "prettier --write .",
    "lint": "scripts/with-node.sh bash -c 'tsc && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0'",
    "test": "scripts/with-node.sh vitest run",
    "test:e2e": "scripts/with-node.sh playwright test"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.1",
    "@clerk/tanstack-react-start": "^1.7.5",
    "@clerk/themes": "^2.4.57",
    "@convex-dev/react-query": "^0.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.47.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-config": "^0.4.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.54",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
